<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.8</Version>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- Publish optimizations -->
	<!--
		NativeAOT cannot be combined with PublishSingleFile, and the native dependencies
		(Skia, HarfBuzz, ANGLE) ship as prebuilt DLLs that would otherwise sit beside the
		executable. They are embedded as managed resources instead, then extracted and
		preloaded by NativeLibraryLoader so a single .exe remains the whole deliverable.
	-->
	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<SelfContained>true</SelfContained>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<InvariantGlobalization>true</InvariantGlobalization>
		<StripSymbols>true</StripSymbols>
		<OptimizationPreference>Size</OptimizationPreference>
		<EmbedNativeLibraries>true</EmbedNativeLibraries>
	</PropertyGroup>

	<!-- Required for Avalonia's Win32 COM interop (tray icon, drag/drop) under NativeAOT. -->
	<PropertyGroup>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\Icon.ico" />
		<EmbeddedResource Include="Assets\Notification.wav" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Infrastructure\Images\" />
	</ItemGroup>

	<!--
		Embed the native dependencies resolved from NuGet runtime assets as managed
		resources so the published output is a single executable. Runs after reference
		resolution (when NativeCopyLocalItems is populated) and before resource names are
		computed. NativeLibraryLoader reads them back using the TinyTrophy.Native.* names.
		NativeCopyLocalItems also carries the matching .pdb symbol files, which are far
		larger than the libraries themselves and must not be embedded.
	-->
	<Target Name="EmbedNativeLibraries"
			AfterTargets="ResolveReferences"
			BeforeTargets="PrepareResourceNames"
			Condition="'$(EmbedNativeLibraries)' == 'true'">
		<ItemGroup>
			<NativeLibraryToEmbed Include="@(NativeCopyLocalItems)"
								  Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.so' or '%(Extension)' == '.dylib'" />
			<EmbeddedResource Include="@(NativeLibraryToEmbed)">
				<LogicalName>TinyTrophy.Native.%(Filename)%(Extension)</LogicalName>
				<Visible>false</Visible>
			</EmbeddedResource>
		</ItemGroup>
	</Target>

	<!--
		Drop the now-embedded natives and every .pdb from the publish output so only the
		AOT executable ships.
	-->
	<Target Name="RemoveRedundantPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(Configuration)' != 'Debug'">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.pdb'))" />
			<ResolvedFileToPublish Remove="@(NativeCopyLocalItems)" Condition="'$(EmbedNativeLibraries)' == 'true'" />
		</ItemGroup>
	</Target>
</Project>
